generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String @id @default(uuid())
  name     String
  currency String
  settings Json   @default("{}")

  // Nullable — a User created via the old passwordless POST /users flow
  // (mobile/'s Ledgerly app) has neither. A User created via
  // POST /auth/register (mobile-v2) always has both.
  email        String? @unique
  passwordHash String?

  plans             Plan[]
  incomes           Income[]
  accounts          Account[]
  transactions      Transaction[]
  rules             Rule[]
  netWorthSnapshots NetWorthSnapshot[]
  listings          Listing[]
  transfers         Transfer[]
}

model Plan {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  status    String
  createdAt DateTime @default(now())

  sections Section[]
}

enum SectionType {
  ESSENTIAL
  SAVINGS
  GOAL
  FLEXIBLE
}

enum AllocationMode {
  PERCENTAGE
  REMAINDER
}

model Section {
  id             String         @id @default(uuid())
  planId         String
  plan           Plan           @relation(fields: [planId], references: [id])
  parentId       String?
  parent         Section?       @relation("SectionChildren", fields: [parentId], references: [id])
  children       Section[]      @relation("SectionChildren")
  name           String
  type           SectionType
  allocationMode AllocationMode
  percentage     Decimal
  priorityOrder  Int
  protected      Boolean        @default(false)

  // Where this Section's money actually sits, distinct from allocation
  // percentage. Nullable — linking a Section to an Account is optional.
  // Type-matching (SAVINGS Section -> SAVINGS Account, everything else ->
  // SPENDING Account) is enforced in SectionsService, not the DB, since it
  // depends on two rows' types together.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  goal          Goal?
  goalTransfers Transfer[]
  transactions  Transaction[]
  rules         Rule[]
  allocations   SectionAllocation[]
  listings      Listing[]

  // Rule 3 (exactly one REMAINDER section per sibling group) is enforced by a
  // partial unique index added by hand in the init migration — Prisma's
  // schema language can't express a filtered/expression index.
}

// A line item a user plans to spend out of a Section's allocation (e.g.
// "Netflix" under a Flexible/Essentials section) — distinct from Transaction,
// which is an actual logged/scanned spend. Listings are the onboarding
// wizard's planning layer; they don't move money or affect Account.balance.
// Scoped by both sectionId and userId (not derived through the Section/Plan
// chain) so an ownership check is a single indexed lookup, not a join.
model Listing {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  amount    Decimal
  // Day of the month (1-31) this bill is due. Null = no fixed due date.
  // Months shorter than the day clamp to their last day.
  dueDay    Int?
  createdAt DateTime @default(now())
}

enum GoalMode {
  // Lifetime target — accumulates forever until currentAmount hits
  // targetAmount (buy a laptop, build $1000 life savings).
  TARGET
  // A recurring monthly commitment, not a lifetime pot (save 20,000/month).
  // currentAmount tracks only the active calendar month; GoalSchedulerService
  // rolls it into a GoalMonthSnapshot at month boundary and resets to 0.
  MONTHLY_RECURRING
  // Keep at least targetAmount in the account the goal's section is linked
  // to (a reserve / floor). There is nothing to accumulate: progress is the
  // live account balance against targetAmount, so currentAmount is unused.
  RESERVE
}

model Goal {
  id                  String    @id @default(uuid())
  sectionId           String    @unique
  section             Section   @relation(fields: [sectionId], references: [id])
  mode                GoalMode  @default(TARGET)
  targetAmount        Decimal
  // Derived, not hand-set — TransactionsService adjusts this the same way it
  // adjusts Account.balance, on every Transaction tagged to this Goal's
  // section. A contribution (allocation credit) raises it, a withdrawal
  // (a logged or scanned spend) lowers it — same signed-amount convention.
  currentAmount       Decimal
  // TARGET only — MONTHLY_RECURRING has no end date, it just repeats.
  targetDate          DateTime?
  // TARGET only — suggested (target - current) / monthsRemaining from
  // sinkingFundCalculator; MONTHLY_RECURRING has no separate figure, its
  // targetAmount already IS the monthly commitment.
  monthlyContribution Decimal?
  autoCalculated      Boolean   @default(true)
  // MONTHLY_RECURRING only — start of the calendar month currentAmount is
  // currently tracking. Null for TARGET goals.
  currentPeriodStart  DateTime?

  monthSnapshots GoalMonthSnapshot[]
}

// One row per calendar month a MONTHLY_RECURRING goal has rolled past —
// what lets the app tell the user "you fell short by X" / "you had a
// surplus of X" without forcing the shortfall onto the next month. Whether
// to add that surplus/shortfall in going forward is the user's own call.
model GoalMonthSnapshot {
  id           String   @id @default(uuid())
  goalId       String
  goal         Goal     @relation(fields: [goalId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  targetAmount Decimal
  actualAmount Decimal
  createdAt    DateTime @default(now())
}

enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

// A definition, not a running total: one-off income is a single event,
// recurring income is the template a cycle repeats. Either way the
// actual money-received history lives in IncomeReceipt, one row per credit.
model Income {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal
  source    String
  date      DateTime
  recurring Boolean  @default(false)

  // Recurring only — how often nextRunDate advances. Null for one-off income.
  frequency IncomeFrequency?

  // Which Account gets credited. Recurring only: the next due date — catch-up
  // is lazy, nothing runs on a schedule; a request
  // (IncomeSchedulerService.catchUp) walks nextRunDate forward by `frequency`
  // for every cycle that's already due, crediting the Account and logging a
  // receipt each time, until it's not in the past anymore.
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  nextRunDate DateTime?

  allocations SectionAllocation[]
  receipts    IncomeReceipt[]
}

// One row per actual credit — the one-off income itself, or one per
// recurring cycle catch-up applies. This is what answers "how much have we
// actually gotten, and when" — Income alone can't, it's just the definition.
model IncomeReceipt {
  id        String   @id @default(uuid())
  incomeId  String
  income    Income   @relation(fields: [incomeId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  amount    Decimal
  date      DateTime
  createdAt DateTime @default(now())
}

/// One row per section per allocation run, tied to the income event that
/// triggered it. Additive — not in the original ERD, which has no field for
/// a computed amount, but the payday-allocation sequence diagram calls for
/// persisting the result, so this closes that gap the same way
/// NetWorthSnapshot sits alongside the core model.
model SectionAllocation {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  incomeId  String
  income    Income   @relation(fields: [incomeId], references: [id])
  amount    Decimal
  createdAt DateTime @default(now())
}

enum AccountType {
  SAVINGS
  SPENDING
}

model Account {
  id      String      @id @default(uuid())
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  name    String
  type    AccountType
  balance Decimal

  transactions   Transaction[]
  sections       Section[]
  incomes        Income[]
  incomeReceipts IncomeReceipt[]
  transfersOut   Transfer[]      @relation("TransferFrom")
  transfersIn    Transfer[]      @relation("TransferTo")
}

/// Money moved between two of a user's own accounts (salary -> savings).
/// Not a spend, so it has no Section and never touches a budget; it only
/// shifts balance from one Account to the other. Additive.
model Transfer {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Decimal
  note          String?
  // The goal section this transfer pays into (salary -> savings for a goal).
  // Raises that Goal's currentAmount by the same amount.
  goalSectionId String?
  goalSection   Section? @relation(fields: [goalSectionId], references: [id], onDelete: SetNull)
  date          DateTime
  createdAt     DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  // Signed: positive credits the Account (income, refund), negative debits
  // it (a spend). TransactionsService applies this delta to Account.balance
  // on create/update/delete — it isn't just a record, it's the source of
  // truth the balance is derived from.
  amount      Decimal
  description String
  date        DateTime
  source      String
}

model Rule {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  pattern   String
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  date             DateTime
  totalAssets      Decimal
  totalLiabilities Decimal
  netWorth         Decimal
}
